<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.type.television" android:required="false" />

    <!-- Explicitly declare that a touchscreen and microphone are not required for TV compatibility -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- RECORD_AUDIO removed - no voice search to avoid privacy policy requirement -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Kanały z nagrań (demolive/RecordedChannelLoader): odczyt paczek z
         PUBLICZNEGO <karta SD>/PlayRec/ — na PLAY BOX (Android 11) adb push
         do Android/data nie działa nawet na karcie. Nadawane wyłącznie przez
         adb appops (makieta badawcza, nie prod):
         adb shell appops set (z flagą uid) com.uxellence.tv.prod MANAGE_EXTERNAL_STORAGE allow -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.TVComponenty"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:localeConfig="@xml/locales_config">

        <!-- LauncherActivity: Entry point when app is set as Android TV Launcher (HOME button) -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:resizeableActivity="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- EpgActivity: Entry point when app is launched from app drawer -->
        <activity
            android:name=".EpgActivity"
            android:exported="true"
            android:resizeableActivity="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity: Development/testing entry point (not exported for production) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:resizeableActivity="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
        </activity>

        <!-- AccessibilityService for HOME button interception -->
        <service
            android:name=".HomeButtonAccessibilityService"
            android:label="BOX TV Home Button Handler"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Rive removed - EPG-only app -->

        <!-- FileProvider for APK installation (Android 7+) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Szybka podmiana tokenu JWT kanałów live z adb (token rotuje codziennie,
             wpisywanie 285 znaków pilotem jest niewykonalne). Patrz LiveTokenReceiver.
             exported=true jest konieczne, żeby `adb shell am broadcast` dosięgnął
             receivera — świadome ustępstwo makiety badawczej. -->
        <receiver
            android:name=".channels.LiveTokenReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.uxellence.tv.prod.SET_LIVE_TOKEN" />
                <action android:name="com.uxellence.tv.prod.CLEAR_LIVE_TOKEN" />
                <action android:name="com.uxellence.tv.prod.REFRESH_LIVE_TOKEN" />
            </intent-filter>
        </receiver>

    </application>

</manifest>

